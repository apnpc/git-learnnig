{
  "title": "Git Learning - Git 完整学习路径",
  "description": "面向初学者的 Git 完整学习路径，从基础到高级，从理论到实战",
  "author": "Git Learning Community",
  "language": "zh-hans",
  "gitbook": "3.2.3",
  "root": ".",
  "structure": {
    "readme": "README.md",
    "summary": "SUMMARY.md"
  },
  "plugins": [
    "github",
    "splitter",
    "page-toc-button",
    "back-to-top-button",
    "expandable-chapters-small",
    "anchors",
    "copy-code-button",
    "search-plus",
    "-lunr",
    "-search",
    "prism",
    "-highlight"
  ],
  "pluginsConfig": {
    "github": {
      "url": "https://github.com/apnpc/git-learnnig"
    },
    "sharing": {
      "facebook": false,
      "twitter": false,
      "weibo": true,
      "all": ["facebook", "google", "twitter", "weibo", "instapaper"]
    },
    "page-toc-button": {
      "maxTocDepth": 2,
      "minTocSize": 2
    },
    "prism": {
      "css": [
        "prismjs/themes/prism-tomorrow.css"
      ]
    }
  },
  "links": {
    "sidebar": {
      "GitHub 仓库": "https://github.com/apnpc/git-learnnig"
    }
  }
}
